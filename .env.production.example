# ============================================================================
# Template environment PRODUKSI untuk Batik Pandansari (Laravel + Vite).
# Salin manual nilai yang relevan ke .env server produksi.
# Jangan commit file .env yang berisi APP_KEY/kredensial asli.
# ============================================================================

APP_NAME="Batik Pandansari"
APP_ENV=production
# Isi hasil: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.example
# APP_URL juga dipakai untuk URL aset; pastikan HTTPS.

# Reverse proxy (nginx/Cloudflare/ngrok). Isi daftar IP proxy tepercaya.
# Jangan gunakan '*' bila aplikasi bisa diakses langsung dari internet.
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database ---------------------------------------------------------------
# Pilih salah satu. Contoh MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=batik_pandansari
# DB_USERNAME=batik
# DB_PASSWORD=ganti-dengan-password-kuat
DB_CONNECTION=sqlite

# --- Session & cookie -------------------------------------------------------
# Produksi sebaiknya memakai database/redis, bukan file, bila multi-server.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# null = Secure otomatis saat HTTPS (disarankan).
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

# Masa berlaku cookie panel admin/teknisi (menit).
PANEL_SESSION_TTL=720

# --- Cache/queue/broadcast --------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@domain-anda.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (Vite) --------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# URL API backend. Ganti bila domain/tunnel berubah, lalu build ulang aset.
VITE_API_URL=https://api.domain-anda.example/api

# Opsional: path CA bundle untuk verifikasi TLS server-side (MediaProxy & panel).
# Kosongkan di server production yang CA-nya sudah lengkap.
MEDIA_PROXY_CA_BUNDLE=

# Client ID Google OAuth (Web application). Kosong = tombol Google dinonaktifkan.
VITE_GOOGLE_CLIENT_ID=
