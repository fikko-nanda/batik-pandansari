APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@batikpandansari.com"
MAIL_FROM_NAME="Batik Pandansari"
MAIL_BRAND_NAME="Batik Pandansari"
MAIL_BRAND_TAGLINE="Warisan Batik, Keindahan Abadi"
MAIL_OUTBOUND_RATE_SECONDS=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MIDTRANS_MERCHANT_ID=G591689893
# Isi dengan kredensial Midtrans Anda sendiri (jangan commit key asli).
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Batas notifikasi webhook Midtrans per menit per IP (cegah banjir request).
MIDTRANS_WEBHOOK_THROTTLE=60
# URL pengalihan hasil pembayaran Midtrans Snap. Kosongkan agar memakai
# bawaan APP_URL (/pembayaran/selesai, /pembayaran/tertunda, /pembayaran/gagal).
# Arahkan ke domain frontend SPA Anda bila halaman terpisah.
MIDTRANS_FINISH_REDIRECT_URL=
MIDTRANS_UNFINISH_REDIRECT_URL=
MIDTRANS_ERROR_REDIRECT_URL=

RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=
# Kosongkan agar file CA otomatis terdeteksi (php.ini atau cacert bawaan SDK Midtrans).
# Isi dengan path cacert.pem khusus bila ingin memaksa file tertentu.
RAJAONGKIR_VERIFY=

# Client ID/Secret OAuth 2.0 dari Google Cloud Console → Credentials.
# Dibutuhkan untuk login/tautan akun Google (POST /api/auth/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
