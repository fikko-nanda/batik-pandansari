APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# URL backend API (team backend). URL ngrok free berubah setiap mereka
# merestart tunnel — update di .env, disetel saat `npm run build`.
# Fallback default: https://overshoot-rasping-afford.ngrok-free.dev/api
# URL API backend (ngrok) — WAJIB diisi saat menjalankan frontend.
# Gunakan akhiran /api sesuai prefix route backend. Ubah nilai ini setiap kali
# tunnel ngrok berubah, lalu restart Vite (composer dev) atau build ulang.
VITE_API_URL=https://overshoot-rasping-afford.ngrok-free.dev/api
# Opsional (Windows dev): path CA bundle agar MediaProxy bisa verifikasi TLS ngrok.
# Contoh: MEDIA_PROXY_CA_BUNDLE="C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt"
# Kosongkan di server production yang CA-nya sudah lengkap.
MEDIA_PROXY_CA_BUNDLE=

# Masa berlaku cookie panel admin/teknisi (menit).
PANEL_SESSION_TTL=720

# Client ID Google OAuth (Google Identity Services) untuk tombol "Masuk via Google"
# dan "Tautkan Akun Google". Ambil dari Google Cloud Console (OAuth 2.0 Client ID,
# tipe Web application). Kosong = fitur Google dinonaktifkan (tombol menampilkan pesan).
VITE_GOOGLE_CLIENT_ID=
